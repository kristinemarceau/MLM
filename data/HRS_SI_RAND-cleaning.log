. ** Smoking - categorical (never, former, current) & binary (never/former, current)
. label define smokecatlab 0 "never" 1 "former" 2 "current"

. label define smokeBlab 0 "not current" 1 "current smoker"

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 1/16 {
  2.     local year : word `i' of `years'
  3. 
.     gen smokecat`year' = .
  4.     replace smokecat`year' = 0 if r`i'smokev==0 & r`i'smoken==0     // never
  5.     replace smokecat`year' = 1 if r`i'smokev==1 & r`i'smoken==0     // former
  6.     replace smokecat`year' = 2 if r`i'smoken==1                     // current
  7.     replace smokecat`year' = r`i'smokev if mi(smokecat`year') & mi(r`i'smokev) & r`i'smokev!=.
  8.     replace smokecat`year' = r`i'smoken if mi(smokecat`year') & mi(r`i'smoken) & r`i'smoken!=.
  9.     label values smokecat`year' smokecatlab 
 10.     label var smokecat`year' "Smoking status (3 cat), `year'"
 11. 
.     gen smokeB`year' = .
 12.     replace smokeB`year' = 0 if inlist(smokecat`year',0,1)
 13.     replace smokeB`year' = 1 if smokecat`year'==2
 14.     replace smokeB`year' = smokecat`year' if mi(smokecat`year') & smokecat`year'!=.
 15.     label values smokeB`year' smokeBlab 
 16.     label var smokeB`year' "Current smoker (binary), `year'"
 17. }
