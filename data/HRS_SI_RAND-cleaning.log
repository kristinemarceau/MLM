. ** Cognition -- continuous (0-27), ordinal (dementia[0-6], cognitive impairment no dementia[CIND; 7-11], normal; 12+), binary (dementia [0-6], no dementia [7+])
. * available from W3(1996) to W15(2020).
. label define cogcatlab 0 "dementia" 1 "CIND" 2 "normal"

. label define cogBlab 0 "no dementia" 1 "has dementia"

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 3/15 {
  2.     local year : word `i' of `years'
  3.     gen cog`year' = r`i'cog27           
  4.     label var cog`year' "Cognitive function(0-27), `year'"
  5. 
.     gen cogcat`year' = .
  6.     replace cogcat`year' = 0 if cog`year'<7  & !missing(cog`year')
  7.     replace cogcat`year' = 1 if inrange(cog`year',7,11)
  8.     replace cogcat`year' = 2 if cog`year'>11 & !missing(cog`year')
  9.     replace cogcat`year' = cog`year' if mi(cog`year') & cog`year'!=.
 10.     label values cogcat`year' cogcatlab
 11.     label var cogcat`year' "Cognition, 3 categories, `year'"
 12. 
.     gen cogB`year' = .
 13.     replace cogB`year' = 1 if cog`year'<7  & !missing(cog`year')
 14.     replace cogB`year' = 0 if cog`year'>=7 & !missing(cog`year')
 15.     replace cogB`year' = cog`year' if mi(cog`year') & cog`year'!=.
 16.     label values cogB`year' cogBlab
 17.     label var cogB`year' "has Dementia (binary), `year'"
 18. }
