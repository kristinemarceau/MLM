. // 3. Health Information
. ********************************************************************************
. ** Self-Rated Health - Ordinal & Binary
. label define srhealthlab 1 "poor" 2 "fair" 3 "good" 4 "very good" 5 "excellent"

. label define srhealthBlab 0 "poor/fair" 1 "good+"

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 1/16 {
  2.     local year : word `i' of `years'
  3. 
.     gen srhealth`year' = .
  4.     replace srhealth`year' = 1 if r`i'shlt==5
  5.     replace srhealth`year' = 2 if r`i'shlt==4  
  6.     replace srhealth`year' = 3 if r`i'shlt==3  
  7.     replace srhealth`year' = 4 if r`i'shlt==2     
  8.     replace srhealth`year' = 5 if r`i'shlt==1     
  9.     replace srhealth`year' = r`i'shlt if mi(r`i'shlt) & r`i'shlt!=.
 10.     label values srhealth`year' srhealthlab 
 11.     label var srhealth`year' "Self-rated health, `year'"
 12. 
.     * Binary
.     gen srhealthB`year' = .
 13.     replace srhealthB`year' = 0 if inlist(srhealth`year',1,2)
 14.     replace srhealthB`year' = 1 if inlist(srhealth`year',3,4,5)
 15.     replace srhealthB`year' = srhealth`year' if mi(srhealth`year') & srhealth`year'!=.
 16.     label values srhealthB`year' srhealthBlab 
 17.     label var srhealthB`year' "SRH binary, `year'"
 18. }
