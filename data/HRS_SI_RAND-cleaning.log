. ** Sleep Trouble (W6-W16), reverse-coded so higher values mean more frequent sleep trouble:
. label define sleepfreq 1 "rarely or never" 2 "sometimes" 3 "most of the time", replace

. capture label define yesno 0 "no" 1 "yes", replace

. 
. local slpstub "sleepfall sleepwakn sleepwake"

. local slpsrc  "sleepfal  sleepwkn  sleepwke"

. local nslp : word count `slpstub'

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 1/16 {
  2.     local year : word `i' of `years'
  3. 
.     foreach s of local slpstub {
  4.         gen `s'`year'  = .
  5.         gen `s'B`year' = .
  6.     }
  7. 
.     * Sleep items are available W6-W16 only
.     if `i' >= 6 {
  8.         forvalues v = 1/`nslp' {
  9.             local s   : word `v' of `slpstub'
 10.             local src : word `v' of `slpsrc'
 11. 
.             capture confirm variable r`i'`src'
 12.             if !_rc {
 13.                 replace `s'`year' = 4 - r`i'`src' if inrange(r`i'`src',1,3)
 14.                 replace `s'`year' = r`i'`src' if mi(r`i'`src') & r`i'`src'!=.
 15. 
.                 * Frequent difficulty = most of the time
.                 replace `s'B`year' = 1 if `s'`year'==3
 16.                 replace `s'B`year' = 0 if inlist(`s'`year',1,2)
 17.                 replace `s'B`year' = `s'`year' if mi(`s'`year') & `s'`year'!=.
 18.             }
 19.         }
 20.     }
 21. 
.     foreach s of local slpstub {
 22.         label values `s'`year'  sleepfreq
 23.         label values `s'B`year' yesno
 24.     }
 25. 
.     egen _slpn`year' = rowtotal(sleepfallB`year' sleepwaknB`year' sleepwakeB`year')
 26.     egen _slpm`year' = rowmiss(sleepfallB`year' sleepwaknB`year' sleepwakeB`year')
 27.     gen sleeptrouble`year' = _slpn`year' if _slpm`year' < 3
 28.     drop _slpn`year' _slpm`year'
 29. 
.     label var sleepfall`year'    "Trouble falling asleep, `year'"
 30.     label var sleepwakn`year'    "Trouble waking during night, `year'"
 31.     label var sleepwake`year'    "Trouble waking too early, `year'"
 32.     label var sleepfallB`year'   "Trouble falling asleep (binary), `year'"
 33.     label var sleepwaknB`year'   "Night waking (binary), `year'"
 34.     label var sleepwakeB`year'   "Early waking (binary), `year'"
 35.     label var sleeptrouble`year' "# of sleep problem, `year'"
 36. }
