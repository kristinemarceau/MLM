. ** Depressive Symptoms: CES-D, W2-W16
. *# Note: Wave 3(1996) -> introduced War Baby cohort, might explain the hight average cesd. 
. *# Note: RwCESD is the sum of 6 negative + 2 reverse-scored positive items = 0..8., NOT comparable for W1(1992).
. label define cesd4Blab 0 "CES-D <4" 1 "CES-D >=4 (elevated)"

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 2/16 {
  2.     local year : word `i' of `years'
  3.     gen cesd`year' = r`i'cesd
  4.     label var cesd`year' "CES-D score (0-8), `year'"
  5. 
.     gen cesd_mean`year' = cesd`year'/8 if inrange(cesd`year',0,8)
  6.     replace cesd_mean`year' = cesd`year' if mi(cesd`year') & cesd`year'!=.
  7.     label var cesd_mean`year' "CES-D mean (0-1), `year'"
  8. 
.     gen cesd4B`year' = .
  9.     replace cesd4B`year' = 0 if inrange(cesd`year',0,3)
 10.     replace cesd4B`year' = 1 if inrange(cesd`year',4,8)
 11.     replace cesd4B`year' = cesd`year' if mi(cesd`year') & cesd`year'!=.
 12.     label values cesd4B`year' cesd4Blab
 13.     label var cesd4B`year' "Elevated depressive symptoms, CES-D>=4 (binary), `year'"
 14. 
.     * # of missing CES-D items (RwCESDM)
.     capture confirm variable r`i'cesdm
 15.     if !_rc {
 16.         gen cesd_nmiss`year' = r`i'cesdm
 17.         label var cesd_nmiss`year' "# missing CES-D items, `year'"
 18.     }
 19. 
.     * single CES-D "felt lonely" item (RwFLONE), binary 0/1, W2-W16
.     capture confirm variable r`i'flone
 20.     if !_rc {
 21.         gen lonely_cesd`year' = r`i'flone
 22.         label var lonely_cesd`year' "CES-D felt-lonely item (binary), `year'"
 23.     }
 24. }
