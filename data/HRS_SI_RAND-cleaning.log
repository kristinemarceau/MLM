. // 5. Leave-Behind Psychosocial (W8/2006 onward; rotating half-sample)
. ********************************************************************************
. * Note: Positive/negative affect use a 6-item version in W8 only, W9+ uses more items, so W8 posaffect/negaffect are left missing.
. local lbstubs  "lonely3 lonely11 chronicstress posaffect negaffect lifesat satfin satfam sathlth satleis big5neur big5ext big5open big5agr big5con5 big5con10"

. local lbsrc    "lblonely3 lblonely11 lbonchrstr lbposaffect lbnegaffect lbsatwlf lbsatfin lbsatfam lbsathlth lbsatleisure lbneur lbext lbopen lbagr lbcon5 lbcon10"

. local nlb : word count `lbstubs'

. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 8/16 {
  2.     local year : word `i' of `years'
  3. 
.     forvalues k = 1/`nlb' {
  4.         local s   : word `k' of `lbstubs'
  5.         local src : word `k' of `lbsrc'
  6. 
.         gen `s'`year' = .
  7.                 
.         if `i' == 8 & inlist("`s'", "posaffect", "negaffect") continue
  8. 
.         capture confirm variable r`i'`src'
  9.         if !_rc replace `s'`year' = r`i'`src'
 10.     }
 11. 
.     label var lonely3`year'       "Loneliness, 3-item (LB), `year'"
 12.     label var lonely11`year'      "Loneliness, 11-item (LB), `year'"
 13.     label var chronicstress`year' "Ongoing chronic stress scale (LB), `year'"
 14.     label var posaffect`year'     "Positive affect (LB), `year'"
 15.     label var negaffect`year'     "Negative affect (LB), `year'"
 16.     label var lifesat`year'       "Life satisfaction (LB), `year'"
 17.     label var satfin`year'        "Satisfaction: finances (LB), `year'"
 18.     label var satfam`year'        "Satisfaction: family (LB), `year'"
 19.     label var sathlth`year'       "Satisfaction: health (LB), `year'"
 20.     label var satleis`year'       "Satisfaction: leisure (LB), `year'"
 21.     label var big5neur`year'      "Big-5 neuroticism (LB), `year'"
 22.     label var big5ext`year'       "Big-5 extraversion (LB), `year'"
 23.     label var big5open`year'      "Big-5 openness (LB), `year'"
 24.     label var big5agr`year'       "Big-5 agreeableness (LB), `year'"
 25.     label var big5con5`year'      "Big-5 conscientiousness, 5-item (LB), `year'"
 26.     label var big5con10`year'     "Big-5 conscientiousness, 10-item (LB), `year'"
 27. }
