. 
. ** Vision & Hearing  (self-reported ratings)
. * Ratings are on a 1-5 scale: 1=poor 2=fair 3=good 4=very good 5=excellent
. * eyesight/hearing: W1-W16， near_eyesight/far_eyesight: W3-W16
. label define srscale5  1 "poor" 2 "fair" 3 "good" 4 "very good" 5 "excellent", replace

. label define srscale5B 0 "poor/fair" 1 "good/very good/excellent", replace

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 1/16 {
  2.     local year : word `i' of `years'
  3. 
.     * eyesight/hearing: available W1-W16
.     gen eyesight`year' = .
  4.     capture confirm variable r`i'eyert
  5.     if !_rc replace eyesight`year' = r`i'eyert
  6. 
.     gen hearing`year' = .
  7.     capture confirm variable r`i'earrt
  8.     if !_rc replace hearing`year' = r`i'earrt
  9. 
.     * near/far eyesight: available W3-W16 only
.     gen near_eyesight`year' = .
 10.     if `i' >= 3 {
 11.         capture confirm variable r`i'eyenr
 12.         if !_rc replace near_eyesight`year' = r`i'eyenr
 13.     }
 14. 
.     gen far_eyesight`year' = .
 15.     if `i' >= 3 {
 16.         capture confirm variable r`i'eyefr
 17.         if !_rc replace far_eyesight`year' = r`i'eyefr
 18.     }
 19. 
.     * binary versions
.     foreach s in eyesight hearing near_eyesight far_eyesight {
 20.         gen `s'B`year' = .
 21.         replace `s'B`year' = 0 if inlist(`s'`year',1,2)
 22.         replace `s'B`year' = 1 if inlist(`s'`year',3,4,5)
 23.         replace `s'B`year' = `s'`year' if mi(`s'`year') & `s'`year'!=.
 24. 
.         label values `s'`year'  srscale5
 25.         label values `s'B`year' srscale5B
 26.     }
 27. 
.     label var eyesight`year'       "Self-rated eyesight (1-5), `year'"
 28.     label var hearing`year'        "Self-rated hearing (1-5), `year'"
 29.     label var near_eyesight`year'  "Self-rated near vision (1-5, W3+), `year'"
 30.     label var far_eyesight`year'   "Self-rated distance vision (1-5, W3+), `year'"
 31. 
.     label var eyesightB`year'      "Good eyesight (binary), `year'"
 32.     label var hearingB`year'       "Good hearing (binary), `year'"
 33.     label var near_eyesightB`year' "Good near vision (binary, W3+), `year'"
 34.     label var far_eyesightB`year'  "Good distance vision (binary, W3+), `year'"
 35. }
