. 
. * #Note: for hospital related variables, utilization counts use a 12-month recall in W1 but a 2-year/since-last-interview window in W2+, so W1 is NOT comparable to 
> W2+.
. ** Health care utilization counts and marital-history counts
. ** Hospital/utilization W1 is coded missing because W1 recall window is not comparable with W2+
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. 
. * Hospital / utilization variables
. local hospstub "hspnit ndoctor nhospstay nnursstay nnursnit"

. local hospsrc  "hspnit doctim  hsptim    nrstim    nrsnit"

. local nhosp : word count `hospstub'

. * Marital-history variables
. local marstub "nmarry ndivorce nwidow"

. local marsrc  "mrct   mdiv     mwid"

. local nmar : word count `marstub'

. 
. forvalues i = 1/16 {
  2.     local year : word `i' of `years'
  3. 
.     * Hospital/utilization variables - W1/1992 stays missing
.     forvalues v = 1/`nhosp' {
  4.         local s   : word `v' of `hospstub'
  5.         local src : word `v' of `hospsrc'
  6. 
.         gen `s'`year' = .
  7.         capture confirm variable r`i'`src'
  8.         if !_rc & `i' > 1 replace `s'`year' = r`i'`src'
  9.     }
 10. 
.     * Marital-history variables
.     forvalues v = 1/`nmar' {
 11.         local s   : word `v' of `marstub'
 12.         local src : word `v' of `marsrc'
 13. 
.         gen `s'`year' = .
 14.         capture confirm variable r`i'`src'
 15.         if !_rc replace `s'`year' = r`i'`src'
 16.     }
 17.     label var hspnit`year'    "# nights in hospital, `year'"
 18.     label var ndoctor`year'   "# doctor visits, `year'"
 19.     label var nhospstay`year' "# hospital stays, `year'"
 20.     label var nnursstay`year' "# nursing-home stays, `year'"
 21.     label var nnursnit`year'  "# nursing-home nights, `year'"
 22. 
.     label var nmarry`year'    "# marriages (cumulative), `year'"
 23.     label var ndivorce`year'  "# times divorced (cumulative), `year'"
 24.     label var nwidow`year'    "# times widowed (cumulative), `year'"
 25. }
