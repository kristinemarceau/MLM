. 
. ** Alcohol Consumption
. *# drinks per day when respondent drinks (count), # days per week respondent drinks (count), heavy drinking (binary), binge drinking (binary)
. *# Note1: (W3:1996 -> W15:2020)drinksday & dayweekdrink, so others waves are coded as missing for comparablity.
. *# Note2: If a respondent is missing on either drinksday or dayweekdrink, then they will also be missing on drinksweek
. *# Note3: new COUNT variables added: drinksday, dayweekdrink, drinksweek.
. label define heavydrinklab 0 "not heavy" 1 "heavy drinker"

. label define bingedrinklab 0 "no binge" 1 "binge"

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 3/16 {
  2.     local year : word `i' of `years'
  3. 
.     * # drinks per day when drinking (top-code at 30)
.     gen drinksday`year' = r`i'drinkn
  4.     replace drinksday`year' = 30 if drinksday`year'>30 & !missing(drinksday`year')
  5.     label var drinksday`year' "# alcoholic drinks per drinking day, `year', count"
  6. 
.     * # days per week drinking
.     gen dayweekdrink`year' = r`i'drinkd
  7.     label var dayweekdrink`year' "# days per week drinking, `year', count"
  8. 
.     * # total drinks per week (missing if either component missing)
.     gen drinksweek`year' = .
  9.     replace drinksweek`year' = drinksday`year'*dayweekdrink`year' ///
>         if !missing(drinksday`year', dayweekdrink`year')
 10.     label var drinksweek`year' "# alcoholic drinks per week, `year', count"
 11. 
.     * heavy drinker: men 15+/wk, women 8+/wk
.     gen heavydrink`year' = .
 12.     replace heavydrink`year' = 0 if drinksweek`year'<15 & woman==0 & !missing(drinksweek`year')
 13.     replace heavydrink`year' = 0 if drinksweek`year'<8  & woman==1 & !missing(drinksweek`year')
 14.     replace heavydrink`year' = 1 if drinksweek`year'>=15 & woman==0 & !missing(drinksweek`year')
 15.     replace heavydrink`year' = 1 if drinksweek`year'>=8  & woman==1 & !missing(drinksweek`year')
 16.     label values heavydrink`year' heavydrinklab 
 17.     label var heavydrink`year' "Heavy drinker (binary), `year'"
 18. 
.     * binge: men 5+/day, women 4+/day
.     gen bingedrink`year' = .
 19.     replace bingedrink`year' = 0 if drinksday`year'<5 & woman==0 & !missing(drinksday`year')
 20.     replace bingedrink`year' = 0 if drinksday`year'<4 & woman==1 & !missing(drinksday`year')
 21.     replace bingedrink`year' = 1 if drinksday`year'>=5 & woman==0 & !missing(drinksday`year')
 22.     replace bingedrink`year' = 1 if drinksday`year'>=4 & woman==1 & !missing(drinksday`year')
 23.     label values bingedrink`year' bingedrinklab
 24.     label var bingedrink`year' "Binge drinker (binary), `year'"
 25. }
