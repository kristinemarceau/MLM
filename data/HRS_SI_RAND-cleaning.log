. ** BMI - continous & ordinal & binary 
. label define bmicatlab 0 "normal/underweight" 1 "overweight" 2 "obese"

. label define bmiBlab 0 "normal/underweight" 1 "overweight/obese"

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 1/16 {
  2.     local year : word `i' of `years'
  3. 
.     gen bmi`year' = r`i'bmi
  4.     label var bmi`year' "Body mass index (cont.), `year'"
  5. 
.     gen bmicat`year' = .
  6.     replace bmicat`year' = 0 if bmi`year'<25 & !missing(bmi`year')
  7.     replace bmicat`year' = 1 if inrange(bmi`year',25,29.9999)
  8.     replace bmicat`year' = 2 if bmi`year'>=30 & !missing(bmi`year')
  9.     replace bmicat`year' = bmi`year' if mi(bmi`year') & bmi`year'!=.
 10.     label values bmicat`year' bmicatlab
 11.     label var bmicat`year' "BMI, 3 categories, `year'"
 12. 
.     gen bmiB`year' = .
 13.     replace bmiB`year' = 0 if bmicat`year'==0
 14.     replace bmiB`year' = 1 if inlist(bmicat`year',1,2)
 15.     replace bmiB`year' = bmicat`year' if mi(bmicat`year') & bmicat`year'!=.
 16.     label values bmiB`year' bmiBlab 
 17.     label var bmiB`year' "normal/underweight VS. overweight/obese, `year'"
 18. }
