. * Treatments / aids (0/1).  EYECAT W2-16; EYEGLC W3-16; EARAID W1-16.
. capture label define yesno 0 "no" 1 "yes", replace

. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 1/16 {
  2.     local year : word `i' of `years'
  3. 
.     gen cataract`year' = .
  4.     if `i' >= 2 {
  5.         capture confirm variable r`i'eyecat
  6.         if !_rc replace cataract`year' = r`i'eyecat
  7.     }
  8. 
.     gen glaucoma`year' = .
  9.     if `i' >= 3 {
 10.         capture confirm variable r`i'eyeglc
 11.         if !_rc replace glaucoma`year' = r`i'eyeglc
 12.     }
 13. 
.     gen hearaid`year' = .
 14.     capture confirm variable r`i'earaid
 15.     if !_rc replace hearaid`year' = r`i'earaid
 16. 
.     label values cataract`year' yesno
 17.     label values glaucoma`year' yesno
 18.     label values hearaid`year'  yesno
 19. 
.     label var cataract`year' "Had cataract surgery (W2+), `year'"
 20.     label var glaucoma`year' "Glaucoma treatment (W3+), `year'"
 21.     label var hearaid`year'  "Uses hearing aid, `year'"
 22. }
