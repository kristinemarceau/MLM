. capture label define yesno 0 "no" 1 "yes", replace

. 
. label define dbstagelbl 1 "has diabetes" 2 "borderline" 3 "pre-diabetes" ///
>     4 "blood sugar little high" 5 "impaired glucose tolerance" ///
>     6 "had before, not now" 7 "never had" 10 "other", replace

.         
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 1/16 {
  2.     local year : word `i' of `years'
  3. 
.     gen dboralmed`year' = .
  4.     capture confirm variable r`i'dborlmed
  5.     if !_rc replace dboralmed`year' = r`i'dborlmed
  6. 
.     gen dbinsulin`year' = .
  7.     capture confirm variable r`i'dbinsuln
  8.     if !_rc replace dbinsulin`year' = r`i'dbinsuln
  9. 
.     gen dbdiagyr`year' = .
 10.     if `i' == 1 | `i' >= 7 {
 11.         capture confirm variable r`i'dbdiagyr
 12.         if !_rc replace dbdiagyr`year' = r`i'dbdiagyr
 13.     }
 14. 
.     gen dbstage`year' = .
 15.     if `i' >= 13 {
 16.         capture confirm variable r`i'dbstage
 17.         if !_rc replace dbstage`year' = r`i'dbstage
 18.     }
 19. 
.     label values dboralmed`year' yesno
 20.     label values dbinsulin`year' yesno
 21.     label values dbstage`year' dbstagelbl
 22. 
.     label var dboralmed`year' "Taking oral meds for diabetes, `year'"
 23.     label var dbinsulin`year' "Taking insulin for diabetes, `year'"
 24.     label var dbdiagyr`year'  "Year diabetes first diagnosed, `year'"
 25.     label var dbstage`year'   "Diabetes stage, `year'"
 26. }
