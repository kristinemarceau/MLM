. * Marital Status - 1. Nominal (4 cate) & 2. Binary (married vs not married)
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. * r`i'mstat codes: 1 married;2 married,spouse absent;3 partnered;4 separated; 5 divorced;6 separated/divorced;7 widowed;8 never married.
. forvalues i = 1/16 {
  2.     local year : word `i' of `years'
  3. 
.     gen marstat`year' = .
  4.     replace marstat`year' = 0 if inlist(r`i'mstat,1,2,3)     // married/partnered
  5.     replace marstat`year' = 1 if inlist(r`i'mstat,4,5,6)     // sep/divorced
  6.     replace marstat`year' = 2 if r`i'mstat==7                // widowed
  7.     replace marstat`year' = 3 if r`i'mstat==8                // never married
  8.     replace marstat`year' = r`i'mstat if mi(r`i'mstat) & r`i'mstat!=.
  9.     label define marstat`year' 0 "married/partnered" 1 "separated/divorced" 2 "widowed" 3 "never married"
 10.     label values marstat`year' marstat`year'
 11.     label var marstat`year' "Marital status (4 cat), `year'"
 12. 
.     gen marstatB`year' = .
 13.     replace marstatB`year' = 0 if inlist(marstat`year',1,2,3)
 14.     replace marstatB`year' = 1 if marstat`year'==0
 15.     replace marstatB`year' = marstat`year' if mi(marstat`year') & marstat`year'!=.
 16.     label define marstatB`year' 0 "not currently married" 1 "currently married"
 17.     label values marstatB`year' marstatB`year'
 18.     label var marstatB`year' "Currently married (binary), `year'"
 19. }
