. local strsrc  "lbhlthprb     lbfamhlthprb   lbfamdrugprb   lbworkprb   lbfinprb   lbhouseprb   lbrltnshprb  lbassistprb"

. local nstr : word count `strstub'

. 
. forvalues i = 8/16 {
  2.     local year : word `i' of `years'
  3. 
.     forvalues k = 1/`nstr' {
  4.         local s   : word `k' of `strstub'
  5.         local src : word `k' of `strsrc'
  6. 
.         gen `s'`year' = .
  7. 
.         * Chronic-stressor items are not available in W9/2008
.         if `i' == 9 continue
  8. 
.         capture confirm variable r`i'`src'
  9.         if !_rc replace `s'`year' = r`i'`src'
 10. 
.         label values `s'`year' stresslbl
 11.     }
 12. 
.     label var stress_health`year'  "Ongoing health problem (LB), `year'"
 13.     label var stress_famhlth`year' "Ongoing family health problem (LB), `year'"
 14.     label var stress_famdrug`year' "Ongoing family drug/alcohol problem (LB), `year'"
 15.     label var stress_work`year'    "Ongoing work problem (LB), `year'"
 16.     label var stress_fin`year'     "Ongoing financial strain (LB), `year'"
 17.     label var stress_house`year'   "Ongoing housing problem (LB), `year'"
 18.     label var stress_reltn`year'   "Ongoing relationship problem (LB), `year'"
 19.     label var stress_assist`year'  "Ongoing caregiving/assistance problem (LB), `year'"
 20. }
