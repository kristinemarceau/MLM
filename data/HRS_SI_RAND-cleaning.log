. * W7-W16: vigorous/moderate/light frequency scales 1=every day..5=never
. *          (r`i'vgactx, r`i'mdactx, r`i'ltactx)
. label define yesno 0 "no" 1 "yes", replace

. label define actfreqlbl 1 "every day" 2 ">1/week" 3 "1/week" 4 "1-3/month" 5 "never", replace

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. foreach stub in vigact3plus lightact3plus vigact_freq mdact_freq ltact_freq ///
>                 vigact_weekly mdact_weekly ltact_weekly {
  2.     forvalues i = 1/16 {
  3.         local year : word `i' of `years'
  4.         gen `stub'`year' = .
  5.     }
  6. }
