. ** IADLs - Limitations in Instrumental Activities of Daily Living: whether respondent has difficulty using a telephone, taking medication, handling money, shopping,
>  preparing meals.
. label define iadlBlab 0 "no IADL limitations" 1 "has IADL limitation(s)"

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 2/16 {
  2.     local year : word `i' of `years'
  3.     gen iadl`year' = r`i'iadl5a        // copy keeps .m/.q
  4.     label var iadl`year' "Limitations in IADLs, count, `year'"
  5. 
.     gen iadlB`year' = .
  6.     replace iadlB`year' = 0 if iadl`year'==0
  7.     replace iadlB`year' = 1 if inrange(iadl`year',1,5)
  8.     replace iadlB`year' = iadl`year' if mi(iadl`year') & iadl`year'!=.
  9.     label values iadlB`year' iadlBlab
 10.     label var iadlB`year' "Limitations in IADLs, binary, `year'"
 11. }
