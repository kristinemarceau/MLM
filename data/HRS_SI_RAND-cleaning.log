. ** Diseases (per wave): High Blood Pressure, Diabetes (does NOT distinguish by types), Cancer, Lung Disease, Heart Disease, Stroke, Psychiatric Problems, Arthritisr
> itis
. label define `nm'lab 0 "no" 1 "yes"

. 
. local years 1992 1994 1996 1998 2000 2002 2004 2006 2008 2010 2012 2014 2016 2018 2020 2022

. forvalues i = 1/16 {
  2.     local year : word `i' of `years'
  3.     foreach dz in hibp diab cancr lung heart stroke psych arthr {
  4.         local nm : subinstr local dz "hibp"  "hypertension"
  5.         local nm : subinstr local nm  "diab"  "diabetes"
  6.         local nm : subinstr local nm  "cancr" "cancer"
  7.         local nm : subinstr local nm  "lung"  "lungdz"
  8.         local nm : subinstr local nm  "heart" "heartdz"
  9.         local nm : subinstr local nm  "arthr" "arthritis"
 10.         gen `nm'`year' = .
 11.         replace `nm'`year' = 0 if inlist(r`i'`dz',0,4)
 12.         replace `nm'`year' = 1 if inlist(r`i'`dz',1,3)
 13.         * stroke also has code 2 (=possible/recovered) treated as yes here
.         if "`dz'"=="stroke" replace `nm'`year' = 1 if r`i'`dz'==2
 14.         replace `nm'`year' = r`i'`dz' if mi(r`i'`dz') & r`i'`dz'!=.   // keep .d/.m/.r/.j
 15.         label values `nm'`year' `nm'lab
 16.         label var `nm'`year' "Has `nm', `year'"
 17.     }
 18.     * disease count 0-8; missing if 4+ of the 8 items are missing
.     egen dzcount`year' = rowtotal(hypertension`year' diabetes`year' cancer`year' ///
>         lungdz`year' heartdz`year' stroke`year' psych`year' arthritis`year')
 19.     egen _dzmiss`year' = rowmiss(hypertension`year' diabetes`year' cancer`year' ///
>         lungdz`year' heartdz`year' stroke`year' psych`year' arthritis`year')
 20.     replace dzcount`year' = . if _dzmiss`year' >= 4
 21.     drop _dzmiss`year'
 22.     label var dzcount`year' "Disease count (0-8), `year'"
 23. }
